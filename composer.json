{
    "name": "personal/ai-extraction-api",
    "description": "Personal image extraction API foundation.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.6",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfony/mime": "7.4.*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@php bin/console lint:yaml config",
            "@php bin/console lint:container",
            "@test"
        ]
    },
    "conflict": {
        "symfony/cache": ">=8.0",
        "symfony/config": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0",
        "symfony/dom-crawler": ">=8.0"
    }
}
